# ==============================================================================
# OMNIFLOW AI — გარემოს ცვლადების შაბლონი (.env.example)
# ვერსია: 1.1 | Next.js App Router + Supabase + Multi-Channel AI
# ==============================================================================
# დააკოპირეთ ეს ფაილი სახელად .env.local და ჩაწერეთ თქვენი რეალური გასაღებები.
# არასოდეს ატვირთოთ .env.local საჯარო git რეპოზიტორიაში!
# ==============================================================================

# 1. აპლიკაცია & სერვერი
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# 2. ადმინ დაშბორდის ავთენტიფიკაცია (ერთი პაროლი .env-იდან)
ADMIN_PASSWORD=change_this_to_a_secure_password_123!
SESSION_SECRET=min_32_characters_random_string_for_cookie_signing_abcdef123456

# 3. SUPABASE მონაცემთა ბაზა
# იხილეთ docs/SETUP_SUPABASE.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_api_key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-or-sb_secret_key

# 4. AI მოდელის პროვაიდერი
# არჩევანი: "openrouter" | "gemini" | "openai" | "anthropic"
LLM_PROVIDER=openrouter

# OpenRouter (400+ AI მოდელი)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Google Gemini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (თუ LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (თუ LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 5. TELEGRAM BOT
# იხილეთ docs/SETUP_CHANNELS.md (BotFather-იდან)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_for_telegram_webhook
# შიდა ჯგუფის ან ოპერატორის Chat ID (Handoff შეტყობინებებისთვის)
TELEGRAM_STAFF_CHAT_ID=

# 6. WHATSAPP BUSINESS CLOUD API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_custom_whatsapp_verify_token
WHATSAPP_APP_SECRET=

# 7. FACEBOOK MESSENGER (Meta)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=your_custom_messenger_verify_token
MESSENGER_APP_SECRET=

# 8. ფონური დავალებების CRON დაცვა (Outbox sender)
CRON_SECRET=random_secret_for_cron_jobs_987654321
