# ==============================================================================
# OMNICHANNEL AI SALES & CUSTOMER SUPPORT PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Version: 3.0 | Enhanced English & Georgian Edition
# ==============================================================================
# Copy this file to .env and configure verified values for your environment.
# NEVER commit sensitive API keys or credentials to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME="OmniFlow AI"
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
TIMEZONE=Asia/Tbilisi
DEFAULT_LOCALE=ka

# ------------------------------------------------------------------------------
# 2. BRAND & BUSINESS CONFIGURATION (Matches System Prompt Placeholders)
# ------------------------------------------------------------------------------
BRAND_NAME="TechStore Georgia"
BUSINESS_TYPE="Electronics & Gadgets Retailer"
SUPPORTED_LANGUAGES="ka,en"
CONTACT_INFO="+995 32 2 100 200, info@techstore.ge, Tbilisi, Georgia"
WORKING_HOURS_AND_TIMEZONE="Mon-Sun 10:00 - 20:00 (Asia/Tbilisi, GMT+4)"
HUMAN_HANDOFF_POLICY="Escalate when requested, complaint is complex, fraud alleged, or payment mismatch occurs"

# Shipping & Delivery Policies
CITY_DELIVERY_FEE=5.00
REGIONAL_DELIVERY_FEE=9.00
EXPRESS_DELIVERY_FEE=10.00
FREE_SHIPPING_THRESHOLD=100.00
DELIVERY_TIMEFRAME="Tbilisi: 24h, Regions: 48-72h"

# Banking Details for Wire Transfers
TBC_IBAN="GE00TB0000000000000000"
BOG_IBAN="GE00BG0000000000000000"
RECIPIENT_NAME="TechStore Georgia LLC"
PAYMENT_DESCRIPTION="Order payment"

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omniflow_db?schema=public"

# Supabase Managed DB (Optional if using Supabase client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 4. REDIS CACHE, SESSIONS & QUEUES
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
IDEMPOTENCY_TTL_SECONDS=86400
SESSION_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. AI MODEL PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Choose provider: "openai" | "anthropic" | "google"
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# API Keys (Set the one for your selected provider)
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 6. FACEBOOK MESSENGER INTEGRATION (Meta for Developers)
# ------------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
MESSENGER_PAGE_ID=your-facebook-page-id
MESSENGER_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
MESSENGER_VERIFY_TOKEN=your-custom-webhook-verify-token

# ------------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-waba-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-system-user-token
WHATSAPP_VERIFY_TOKEN=your-custom-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ------------------------------------------------------------------------------
# 8. TELEGRAM BOT API INTEGRATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_WEBHOOK_SECRET=your-random-telegram-secret-token

# ------------------------------------------------------------------------------
# 9. PAYMENT GATEWAYS & VERIFICATION (Optional Automated APIs)
# ------------------------------------------------------------------------------
TBC_PAY_CLIENT_ID=""
TBC_PAY_CLIENT_SECRET=""
BOG_IPAY_CLIENT_ID=""
BOG_IPAY_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 10. AUTHENTICATION & SECURITY KEYS
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-random-jwt-key-min-32-chars
JWT_EXPIRATION="8h"
SESSION_SECRET=super-secret-session-cookie-encryption-key
ENCRYPTION_KEY=32-character-random-aes-secret-key-!!

# ------------------------------------------------------------------------------
# 11. MONITORING, LOGGING & ALERTING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=""
SLACK_ESCALATION_WEBHOOK_URL="https://hooks.slack.com/services/..."
